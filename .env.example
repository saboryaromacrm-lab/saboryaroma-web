# Copiá este archivo a `.env.local` (no se sube al repo ni entra al build de
# Docker — ver .dockerignore) y ajustá los valores.
#
# Las dos variables son NEXT_PUBLIC_*: se HORNEAN en el JavaScript al compilar.
# Cambiarlas en producción es reconstruir la imagen, no reiniciar el contenedor.
# En Dokploy se pasan como argumentos de build (ver Dockerfile).

# URL base de crm-api. En desarrollo, con la API corriendo localmente:
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL pública del sitio. La usan el SEO (canonical, sitemap.xml, robots.txt)
# y los datos estructurados JSON-LD. Si falta en el build de producción, el
# sitio publica `http://localhost:3002` como su propia dirección — sin avisar.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
